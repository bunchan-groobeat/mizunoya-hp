@charset "utf-8";
/* =========================================================
   有限会社 水野谷自動車 テーマトークン上書き (theme.css)
   ・base.css の後に読み込む。base.css は編集しない。
   ・整備工場の信頼感／「国指定認証工場」の公的・堅実なトーン。
   配色: 濃紺ブルー(公的・堅実) + 赤(電話CTA)。
   ========================================================= */

:root{
  --accent:#13497e;      /* 主アクセント: 濃紺ブルー(認証・堅実・信頼) */
  --accent-2:#c8102e;    /* 電話CTA: 赤(緊急連絡の視認性) */
  --base:#222a31;        /* 本文・濃色: ダークスレート */
  --panel:#eef2f6;       /* 淡色面: 帯・フッター背景 */
  --line:#d9dee4;        /* 罫線 */
  --muted:#7a828b;       /* 補助テキスト */
}

/* ---------------------------------------------------------
   テキストロゴ (回収済みロゴ画像が無いため文字ロゴで代替)
   ※【社長確認】正式ロゴ(logo.png)入手後は #header の img に差し替え
--------------------------------------------------------- */
.text_logo{ display:inline-block; line-height:1.25; text-align:left; }
.text_logo .lg_en{ display:block; font-size:11px; letter-spacing:.18em; color:var(--accent); font-weight:bold; }
.text_logo .lg_ja{ display:block; font-size:21px; font-weight:bold; font-family:var(--mincho); color:var(--base); letter-spacing:.02em; }
.text_logo:hover .lg_ja{ color:var(--accent); }
@media (max-width:820px){
  .text_logo .lg_en{ font-size:9px; }
  .text_logo .lg_ja{ font-size:15px; }
}
#footer_logo_image .text_logo .lg_ja{ font-size:24px; }
#footer_logo_image .text_logo{ text-align:center; }

/* ---------------------------------------------------------
   認証バッジ (国指定認証工場の訴求)
--------------------------------------------------------- */
.cert_badge{
  display:inline-flex; align-items:center; gap:12px; padding:12px 22px; border-radius:6px;
  background:var(--accent); color:#fff; font-weight:bold; line-height:1.4;
}
.cert_badge .cert_mark{ font-size:11px; letter-spacing:.14em; opacity:.85; }
.cert_badge .cert_main{ font-size:17px; }
.cert_badge .cert_no{ font-size:13px; font-weight:normal; opacity:.9; }
@media (max-width:820px){ .cert_badge{ flex-direction:column; align-items:flex-start; gap:4px; padding:12px 16px; } }

/* トップの認証ヒーロー帯 */
.cert_hero{ background:linear-gradient(180deg,#0f3a63,#13497e); color:#fff; text-align:center; padding:46px 20px; }
.cert_hero .ch_en{ font-size:12px; letter-spacing:.24em; opacity:.8; font-weight:bold; }
.cert_hero .ch_main{ font-size:26px; font-weight:bold; font-family:var(--mincho); margin:10px 0 6px; line-height:1.5; }
.cert_hero .ch_sub{ font-size:14px; color:#d6e2ee; }
@media (max-width:820px){ .cert_hero{ padding:32px 15px; } .cert_hero .ch_main{ font-size:20px; } }

/* ---------------------------------------------------------
   工程ステップ (鈑金塗装・コーティングの手順表示)
--------------------------------------------------------- */
.process_list{ counter-reset:step; max-width:900px; margin:0 auto; }
.process_step{
  display:flex; gap:22px; padding:24px 0; border-bottom:1px solid var(--line); align-items:flex-start;
}
.process_step:last-child{ border-bottom:none; }
.process_step .st_no{
  flex:0 0 auto; width:46px; height:46px; border-radius:50%; background:var(--accent); color:#fff;
  display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:18px; font-family:var(--mincho);
}
.process_step .st_body{ flex:1 1 auto; }
.process_step .st_title{ font-size:18px; font-weight:bold; margin:6px 0 8px; font-family:var(--mincho); }
.process_step .st_text{ font-size:14.5px; line-height:2; color:var(--base); }
@media (max-width:820px){
  .process_step{ gap:14px; padding:18px 0; }
  .process_step .st_no{ width:38px; height:38px; font-size:16px; }
  .process_step .st_title{ font-size:16px; }
}

/* 特長カード(コーティングの4つの特長など) */
.point_grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:22px; max-width:960px; margin:0 auto; }
.point_card{ border:1px solid var(--line); border-radius:6px; padding:26px 26px 28px; background:#fff; }
.point_card .pc_title{ font-size:17px; font-weight:bold; margin:0 0 10px; color:var(--accent); font-family:var(--mincho); }
.point_card .pc_text{ font-size:14.5px; line-height:2; }
@media (max-width:820px){ .point_grid{ grid-template-columns:1fr; gap:16px; } }

/* ---------------------------------------------------------
   取扱ブランド (ロゴ画像が未回収のため文字リストで信頼感を担保)
   ※【社長確認】各ブランドロゴ回収後は画像グリッドへ差し替え可
--------------------------------------------------------- */
.brand_list{ display:flex; flex-wrap:wrap; gap:12px 14px; justify-content:center; max-width:900px; margin:0 auto; }
.brand_list li{
  border:1px solid var(--line); border-radius:4px; padding:10px 18px; font-size:14px; font-weight:bold;
  color:var(--base); background:#fff; letter-spacing:.03em;
}
.brand_logos{ display:flex; flex-wrap:wrap; gap:20px; justify-content:center; align-items:center; margin:26px auto 0; }
.brand_logos img{ height:38px; width:auto; }

/* お知らせを少し内側に */
.news_wrap{ max-width:820px; margin:0 auto; }

/* ---------------------------------------------------------
   データ表(部品交換の目安 等・2列で左見出しが長文になり得る)
--------------------------------------------------------- */
.spec_table_wrap{ max-width:900px; margin:0 auto; overflow-x:auto; }
.spec_table{ width:100%; border-collapse:collapse; }
.spec_table th,.spec_table td{ border:1px solid var(--line); padding:14px 16px; font-size:14.5px; line-height:1.8; text-align:left; vertical-align:top; }
.spec_table th{ width:38%; background:var(--panel); font-weight:bold; }
.spec_table tbody tr:nth-child(odd){ background:#fafbfc; }
@media (max-width:600px){
  .spec_table th{ width:44%; padding:10px 12px; font-size:13px; }
  .spec_table td{ padding:10px 12px; font-size:13px; }
}

/* =========================================================
   ▼▼▼ TOPページ リニューアル仮組み(2026-07-10 ジロー) ▼▼▼
   ・看板ブランド(赤メイン/紺締め/白ベース)のネオクラシック配色。
   ・すべて body.home スコープ or 新規クラスで、下層ページには影響させない。
   ・base.css は一切変更していない(トークン上書き + 追加クラスのみ)。
========================================================= */

/* --- 看板から目視で拾った基準色(01_看板.jpg) --- */
:root{
  --red:#d8232a;    /* ミズノヤシドウシャ 赤枠ロゴの赤(温かみのある鮮やかな標識赤) */
  --navy:#1a408c;   /* KURU MAYA バッジの紺(彩度高めのロイヤルネイビー) */
}
/* TOPページのみ: base.css の主アクセント(既定は認証工場の濃紺)を「看板赤」に差し替える。
   → section見出しEN・「詳しく見る→」・お知らせ日付・リンクhover・電話CTAが赤系で統一される。 */
.home{ --accent:var(--red); --accent-2:var(--red); }

/* ヘッダー/フッターの仮ロゴ画像(logo-temp.svg は縦長のためサイズ固定) */
.home #header .brand_logo img{ height:54px; width:auto; display:block; }
.home #footer_logo_image .footer_brand_logo{ height:66px; width:auto; }
@media (max-width:820px){
  .home #header .brand_logo img{ height:40px; }
}

/* ---------------------------------------------------------
   1. ヒーロー
--------------------------------------------------------- */
.hero{
  position:relative; min-height:78vh; display:flex; align-items:center; justify-content:center;
  overflow:hidden; background:var(--navy); color:#fff; text-align:center;
}
.hero_bg{ position:absolute; inset:0; }
.hero_bg img{ width:100%; height:100%; object-fit:cover; }
.hero::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(18,26,45,.40),rgba(18,26,45,.66)); }
.hero_inner{ position:relative; z-index:2; padding:70px 20px; max-width:920px; }
.hero_badge_line{ display:flex; align-items:center; justify-content:center; gap:14px; margin:0 0 20px; }
.hero_kuru{ height:42px; width:auto; filter:drop-shadow(0 2px 6px rgba(0,0,0,.35)); }
.hero_since{
  font-family:Arial,var(--sans); font-weight:900; letter-spacing:.26em; font-size:14px;
  padding:6px 14px; border:2px solid #fff; border-radius:3px; background:rgba(216,35,42,.9);
}
.hero_copy{
  font-family:var(--mincho); font-weight:bold; font-size:46px; line-height:1.4; letter-spacing:.02em;
  margin:0 0 18px; text-shadow:0 2px 14px rgba(0,0,0,.35);
}
.hero_lead{ font-size:16px; line-height:1.9; color:#eef2f8; margin:0 0 30px; text-shadow:0 1px 8px rgba(0,0,0,.4); }
.hero_actions{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; align-items:center; }
.hero_scroll{
  position:absolute; left:50%; bottom:18px; transform:translateX(-50%); z-index:3;
  color:#fff !important; font-size:10px; letter-spacing:.22em; font-weight:bold; text-align:center;
}
.hero_scroll_arrow{ display:block; width:1px; height:34px; margin:8px auto 0; background:rgba(255,255,255,.7); position:relative; overflow:hidden; }
.hero_scroll_arrow::after{ content:""; position:absolute; left:0; top:-34px; width:1px; height:34px; background:#fff; animation:scrollLine 1.8s ease-in-out infinite; }
@keyframes scrollLine{ 0%{ transform:translateY(0); } 60%,100%{ transform:translateY(68px); } }
@media (max-width:820px){
  .hero{ min-height:70vh; }
  .hero_copy{ font-size:30px; }
  .hero_lead{ font-size:14px; }
  .hero_kuru{ height:34px; }
}

/* ---------------------------------------------------------
   2. サービスカード4枚(レトロミニカーパッケージ"風"の赤枠ボックス)
--------------------------------------------------------- */
.svc4_grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:22px; }
.svc_card{
  position:relative; display:flex; flex-direction:column; text-align:center;
  background:#fff; border:2px solid var(--red); border-radius:5px; padding:28px 20px 24px;
  box-shadow:0 3px 10px rgba(0,0,0,.05); transition:transform .2s, box-shadow .2s;
}
.svc_card::before{ content:""; position:absolute; inset:5px; border:1px solid rgba(216,35,42,.30); border-radius:3px; pointer-events:none; }
.svc_card:hover{ transform:translateY(-5px); box-shadow:0 14px 28px rgba(0,0,0,.12); }
.svc_icon{ width:60px; height:60px; margin:0 auto 12px; color:var(--red); }
.svc_icon svg{ width:100%; height:100%; }
.svc_no{ display:block; font-family:Arial,var(--sans); font-weight:900; font-size:13px; letter-spacing:.12em; color:var(--navy); }
.svc_title{ display:block; font-family:var(--mincho); font-weight:bold; font-size:20px; margin:2px 0 12px; }
.svc_text{ display:block; font-size:13.5px; line-height:1.9; color:var(--base); text-align:left; flex:1 1 auto; }
.svc_more{ display:block; margin-top:16px; font-size:13px; font-weight:bold; color:var(--red); }
@media (max-width:1000px){ .svc4_grid{ grid-template-columns:repeat(2,1fr); gap:16px; } }
@media (max-width:520px){ .svc4_grid{ grid-template-columns:1fr; } }

/* ---------------------------------------------------------
   3. お知らせ / ブログ(雛形)
--------------------------------------------------------- */
.news_list li{ align-items:center; }
.cat_tag{ font-size:11px; font-weight:bold; color:#fff; background:var(--navy); border-radius:3px; padding:3px 10px; line-height:1.6; }
.news_more_wrap{ text-align:center; margin-top:26px; }
.news_more_note{ font-size:13px; color:var(--muted); }

/* ---------------------------------------------------------
   4. ギャラリー(既存 tile_grid を流用・中央寄せ)
--------------------------------------------------------- */
.gallery_grid{ justify-content:center; }

/* ---------------------------------------------------------
   5. Instagram
--------------------------------------------------------- */
.insta_section .section_head{ margin-bottom:14px; }
.insta_account{ text-align:center; margin:0 0 26px; }
.insta_account a{ font-weight:bold; color:var(--navy); letter-spacing:.04em; }
.insta_account a:hover{ color:var(--red); }

/* ---------------------------------------------------------
   6. 会社案内ダイジェスト
--------------------------------------------------------- */
.company_digest{ background:var(--panel); }
.cd_inner{ display:flex; gap:48px; align-items:center; width:var(--container); max-width:100%; margin:0 auto; padding:84px 20px; }
.cd_lead{ flex:1 1 46%; }
.cd_map{ flex:1 1 54%; }
.cd_since{ font-family:var(--mincho); font-size:22px; font-weight:bold; color:var(--navy); margin:0 0 14px; }
.cd_since strong{ color:var(--red); font-size:26px; }
.cd_text{ font-size:14.5px; line-height:2; margin:0 0 22px; }
.cd_cert{ display:inline-flex; align-items:center; gap:14px; background:#fff; border:1px solid var(--line); border-left:5px solid var(--navy); border-radius:4px; padding:12px 20px; margin:0 0 16px; }
.cd_badge{ height:48px; width:auto; }
.cd_cert_label{ display:block; font-size:11px; color:var(--muted); letter-spacing:.06em; }
.cd_cert_no{ display:block; font-size:20px; font-weight:bold; color:var(--navy); letter-spacing:.04em; }
.cd_access{ font-size:13.5px; color:var(--base); margin:0 0 24px; }
.cd_map .map_wrap{ margin:0; max-width:100%; }
@media (max-width:900px){
  .cd_inner{ flex-direction:column; gap:30px; align-items:stretch; padding:44px 15px; }
  .cd_since strong{ font-size:24px; }
}

/* TOPページ: CTA帯・フッターは"締めの紺"に */
.home .cta_band{ background:var(--navy); }
.home #footer_top{ background:var(--navy); }
.home #footer_top_inner{ color:#fff; }
.home #footer_info{ color:#dfe6f2; }
.home #footer_menu_list a{ color:#fff; }
.home #footer_menu_list a:hover{ color:#ffd0d3; }
.home #footer_bottom{ background:#132f66; }
.home #copyright{ color:#aeb9d0; }

/* ---------------------------------------------------------
   スマホ常時表示 電話ボタン(フローティング)
--------------------------------------------------------- */
.floating_tel{ display:none; }
@media (max-width:820px){
  .floating_tel{
    display:flex; position:fixed; left:12px; right:12px; bottom:12px; z-index:60;
    align-items:center; justify-content:center; gap:12px; padding:11px 16px;
    background:var(--red); color:#fff !important; border-radius:9px; box-shadow:0 6px 18px rgba(0,0,0,.28);
  }
  .floating_tel svg{ width:22px; height:22px; flex:0 0 auto; }
  .floating_tel .ft_txt{ line-height:1.15; text-align:left; }
  .floating_tel .ft_sub{ display:block; font-size:10px; font-weight:normal; }
  .floating_tel .ft_num{ display:block; font-size:20px; font-weight:bold; letter-spacing:.02em; }
  .home #return_top{ right:14px; bottom:80px; width:46px; height:46px; border-radius:50%; }
  body.home{ padding-bottom:74px; }
}

/* ---------------------------------------------------------
   スクロール連動フェードイン(軽量)
--------------------------------------------------------- */
.reveal{ opacity:0; transform:translateY(26px); transition:opacity .7s ease, transform .7s ease; will-change:opacity,transform; }
.reveal.is-visible{ opacity:1; transform:none; }
@media (prefers-reduced-motion: reduce){
  .reveal{ opacity:1 !important; transform:none !important; transition:none; }
  .hero_scroll_arrow::after{ animation:none; }
}
/* ▲▲▲ TOPページ リニューアル仮組み ここまで ▲▲▲ */
