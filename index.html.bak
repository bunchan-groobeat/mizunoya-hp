    <div id="logo_image"><a class="text_logo" href="index.html"><span class="lg_en">MIZUNOYA JIDOSHA</span><span class="lg_ja">有限会社 水野谷自動車</span></a></div>
    <input type="checkbox" id="nav_toggle">
    <label class="nav_toggle_btn" for="nav_toggle" aria-label="メニュー"><span></span></label>
